-AGENT_CLI_BASE_URL="http://127.0.0.1:<port>/v1"   # server local, không cần key
+AGENT_CLI_BASE_URL="http://127.0.0.1:<port>/v1"   # server local tương thích OpenAI của bạn, không cần key
