--- /dev/null
+++ b/internal/agent/false_success_test.go
@@ -0,0 +1,184 @@
+package agent
+
+import (
+	"strings"
+	"testing"
+
+	"charm.land/fantasy"
+	"github.com/charmbracelet/crush/internal/message"
+	"github.com/stretchr/testify/require"
+)
+
+// Bản tóm tắt bị cắt vì hết ngân sách output là bản tóm tắt HỎNG: nhận nó làm
+// điểm cắt thì toàn bộ lịch sử bị thay bằng nửa bản tóm tắt mà không ai hay
+// (audit g1: finish=length bị ghi đè thành end_turn). Giữ lịch sử, làm tiếp.
+func TestTruncatedSummaryKeepsHistory(t *testing.T) {
+	h := newContHarness(t, &scriptModel{script: []string{"tool", "done"},
+		summaryText: "## Current State\n- half of the brie", summaryFinish: fantasy.FinishReasonLength})
+
+	_, err := h.sa.Run(t.Context(), SessionAgentCall{SessionID: h.sid, RunID: "x", Prompt: "refactor the scanner"})
+	require.NoError(t, err)
+	rc := waitRunComplete(t, h.ch, "x")
+	require.Empty(t, rc.Error)
+	require.Equal(t, "done", rc.Text)
+
+	sess, err := h.env.sessions.Get(t.Context(), h.sid)
+	require.NoError(t, err)
+	require.Empty(t, sess.SummaryMessageID, "a truncated summary must not become the history cut point")
+	msgs, err := h.env.messages.List(t.Context(), h.sid)
+	require.NoError(t, err)
+	var failed bool
+	for _, m := range msgs {
+		if m.IsSummaryMessage {
+			f := m.FinishPart()
+			require.NotNil(t, f)
+			failed = f.Reason == message.FinishReasonError
+		}
+	}
+	require.True(t, failed, "the truncated summary is recorded as failed, not end_turn")
+}
+
+// Model trả lời không chữ, không tool call (finish=stop): lượt không làm gì cả.
+// Không có lỗi thì `run` thoát 0 với `text` rỗng (faults.sh ca empty-reply).
+func TestEmptyTurnIsAnError(t *testing.T) {
+	h := newContHarness(t, &scriptModel{script: []string{"empty"}, summaryText: "SUMMARY"})
+
+	_, err := h.sa.Run(t.Context(), SessionAgentCall{SessionID: h.sid, RunID: "x", Prompt: "fix it"})
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "empty reply")
+	rc := waitRunComplete(t, h.ch, "x")
+	require.Contains(t, rc.Error, "empty reply")
+}
+
+// Làm việc bằng tool rồi kết thúc im lặng vẫn là một lượt có làm: không phải lỗi.
+func TestToolWorkThenSilentEndIsNotAnError(t *testing.T) {
+	h := newContHarness(t, &scriptModel{script: []string{"tool_small", "empty"}, summaryText: "SUMMARY"})
+
+	_, err := h.sa.Run(t.Context(), SessionAgentCall{SessionID: h.sid, RunID: "x", Prompt: "fix it"})
+	require.NoError(t, err)
+	rc := waitRunComplete(t, h.ch, "x")
+	require.Empty(t, rc.Error)
+}
+
+// Bị cắt ở giới hạn output giữa tool call viết dở (không có phần ToolCall) hay
+// khi đang nghĩ: đó là việc của nhánh tự làm tiếp, không phải "trả lời rỗng".
+func TestLengthCutWithoutTextIsContinuedNotEmpty(t *testing.T) {
+	for _, step := range []string{"cut_tool", "think_cut"} {
+		t.Run(step, func(t *testing.T) {
+			h := newContHarness(t, &scriptModel{script: []string{step, "done"}, summaryText: "SUMMARY"})
+
+			_, err := h.sa.Run(t.Context(), SessionAgentCall{SessionID: h.sid, RunID: "x", Prompt: "write the big file"})
+			require.NoError(t, err)
+			rc := waitRunComplete(t, h.ch, "x")
+			require.Empty(t, rc.Error)
+			require.Equal(t, "done", rc.Text, "the length continuation ran")
+		})
+	}
+}
+
+// Bộ lọc nội dung từ chối mà không có chữ: giữ lý do từ chối (TUI hiện REFUSED),
+// không đổi thành "trả lời rỗng".
+func TestContentFilterRefusalIsNotReportedAsEmpty(t *testing.T) {
+	h := newContHarness(t, &scriptModel{script: []string{"refused"}, summaryText: "SUMMARY"})
+
+	_, _ = h.sa.Run(t.Context(), SessionAgentCall{SessionID: h.sid, RunID: "x", Prompt: "fix it"})
+	rc := waitRunComplete(t, h.ch, "x")
+	require.NotContains(t, rc.Error, "empty reply")
+	require.Contains(t, rc.Error, "content filter", "a refusal without any output is not a success")
+	msgs, err := h.env.messages.List(t.Context(), h.sid)
+	require.NoError(t, err)
+	last := msgs[len(msgs)-1]
+	require.NotNil(t, last.FinishPart())
+	require.Equal(t, message.FinishReasonContentFilter, last.FinishPart().Reason)
+	// TUI tự viết lời hướng dẫn khi bị từ chối (cmp.Or với Message/Details): không đè.
+	require.Empty(t, last.FinishPart().Message)
+	require.Empty(t, last.FinishPart().Details)
+}
+
+// Trả lời rỗng kết thúc bằng finish khác stop (openai-compat ánh xạ finish lạ như
+// "network_error"/"sensitive" của GLM thành unknown; google có error/other) vẫn
+// là trả lời rỗng, không phải thành công (soát lượt 3, F1).
+func TestEmptyTurnWithOtherFinishReasonsIsAnError(t *testing.T) {
+	for _, step := range []string{"empty_unknown", "empty_error", "empty_other"} {
+		t.Run(step, func(t *testing.T) {
+			h := newContHarness(t, &scriptModel{script: []string{step}, summaryText: "SUMMARY"})
+			_, err := h.sa.Run(t.Context(), SessionAgentCall{SessionID: h.sid, RunID: "x", Prompt: "fix it"})
+			require.Error(t, err)
+			rc := waitRunComplete(t, h.ch, "x")
+			require.Contains(t, rc.Error, "empty reply")
+		})
+	}
+}
+
+// Chuỗi bị cắt mà chưa từng ra chữ hay chạy xong tool call nào: lượt làm tiếp
+// rỗng, hay hết trần làm tiếp, đều là thất bại (soát lượt 3, F2).
+func TestLengthCutChainThatNeverProducesIsAnError(t *testing.T) {
+	cap := make([]string, maxLengthContinues+1)
+	for i := range cap {
+		cap[i] = "think_cut"
+	}
+	for name, script := range map[string][]string{
+		"think_cut then empty": {"think_cut", "empty"},
+		"cut_tool then empty":  {"cut_tool", "empty"},
+		"think_cut until cap":  cap,
+	} {
+		t.Run(name, func(t *testing.T) {
+			h := newContHarness(t, &scriptModel{script: script, summaryText: "SUMMARY"})
+			_, _ = h.sa.Run(t.Context(), SessionAgentCall{SessionID: h.sid, RunID: "x", Prompt: "write the big file"})
+			rc := waitRunComplete(t, h.ch, "x")
+			require.Contains(t, rc.Error, "empty reply")
+		})
+	}
+}
+
+// Nghĩ hết ngân sách đúng lúc vượt ngưỡng tóm tắt: nhánh tóm tắt không xếp lượt
+// làm tiếp (không có tool call), nhánh tự làm tiếp bị bỏ qua khi đang tóm tắt; chuỗi
+// chưa ra gì nên là lỗi, không phải "xong" rỗng (soát lượt 4, R4-A1).
+func TestThinkingCutWhileSummarizingIsAnError(t *testing.T) {
+	h := newContHarness(t, &scriptModel{script: []string{"think_cut_big"}, summaryText: "SUMMARY"})
+	_, _ = h.sa.Run(t.Context(), SessionAgentCall{SessionID: h.sid, RunID: "x", Prompt: "fix it"})
+	rc := waitRunComplete(t, h.ch, "x")
+	require.Contains(t, rc.Error, "empty reply")
+}
+
+// Câu trả lời thật nằm ở khối chữ thứ hai (khối đầu chỉ có khoảng trắng): vẫn là có
+// trả lời (soát lượt 4, R4-A2).
+func TestAnswerInALaterTextBlockIsNotEmpty(t *testing.T) {
+	h := newContHarness(t, &scriptModel{script: []string{"two_text_blocks"}, summaryText: "SUMMARY"})
+	_, err := h.sa.Run(t.Context(), SessionAgentCall{SessionID: h.sid, RunID: "x", Prompt: "fix it"})
+	require.NoError(t, err)
+	rc := waitRunComplete(t, h.ch, "x")
+	require.Empty(t, rc.Error)
+	require.Contains(t, rc.Text, "the real answer")
+}
+
+// Lượt làm tiếp sau tự tóm tắt kết thúc im lặng: chuỗi của prompt đã làm việc,
+// nên không phải lỗi.
+func TestSilentContinuationAfterSummaryIsNotAnError(t *testing.T) {
+	h := newContHarness(t, &scriptModel{script: []string{"tool", "empty"}, summaryText: "SUMMARY"})
+
+	_, err := h.sa.Run(t.Context(), SessionAgentCall{SessionID: h.sid, RunID: "x", Prompt: "fix it"})
+	require.NoError(t, err)
+	rc := waitRunComplete(t, h.ch, "x")
+	require.Empty(t, rc.Error)
+	kinds, _ := h.model.seen()
+	require.Equal(t, []string{"work", "summary", "work"}, kinds)
+}
+
+// Loop detection dừng lượt vì model lặp cùng một tool call: đó là thất bại, không
+// phải "xong". RunComplete phải mang lỗi để `run` thoát khác 0 (audit C-06).
+func TestLoopDetectionStopIsAnError(t *testing.T) {
+	script := make([]string, 20)
+	for i := range script {
+		script[i] = "tool_small"
+	}
+	h := newContHarness(t, &scriptModel{script: script, summaryText: "SUMMARY"})
+
+	_, err := h.sa.Run(t.Context(), SessionAgentCall{SessionID: h.sid, RunID: "x", Prompt: "fix it"})
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "repeated the same tool call")
+	rc := waitRunComplete(t, h.ch, "x")
+	require.Contains(t, rc.Error, "repeated the same tool call")
+	kinds, _ := h.model.seen()
+	require.Less(t, strings.Count(strings.Join(kinds, ","), "work"), 20, "the loop is cut before the script runs out")
+}
diff --git a/internal/agent/llm_ledger.go b/internal/agent/llm_ledger.go
new file mode 100644
index 00000000..9c168464
--- /dev/null
+++ b/internal/agent/llm_ledger.go
@@ -0,0 +1,195 @@
+package agent
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"log/slog"
+	"os"
+	"sort"
+	"strings"
+	"sync"
+	"time"
+
+	"charm.land/fantasy"
+	"github.com/charmbracelet/crush/internal/agent/tools"
+	"github.com/charmbracelet/crush/internal/execpolicy"
+)
+
+// Sổ ghi lời gọi LLM (opt-in, AGENT_CLI_LLM_LEDGER=<tệp>): mỗi lời gọi một dòng
+// JSON nói vai trò, provider/model THẬT đã gọi, kích thước prompt và usage của
+// chính lời gọi đó. Chỉ có kích thước và hash, không chép nội dung prompt. Dùng để
+// chứng minh "phiên chọn provider X không gọi provider khác" và để đo token thật
+// (bộ đếm token của session chỉ giữ bước cuối).
+
+type llmRoleKey struct{}
+
+// withLLMRole gắn vai trò cho mọi lời gọi LLM đi qua ctx.
+func withLLMRole(ctx context.Context, role string) context.Context {
+	return context.WithValue(ctx, llmRoleKey{}, role)
+}
+
+func llmRole(ctx context.Context) string {
+	if r, ok := ctx.Value(llmRoleKey{}).(string); ok && r != "" {
+		return r
+	}
+	return "main"
+}
+
+type ledgerEntry struct {
+	Time            string `json:"time"`
+	DurationMS      int64  `json:"duration_ms"`
+	Role            string `json:"role"`
+	SessionID       string `json:"session_id,omitempty"`
+	Provider        string `json:"provider"`
+	Model           string `json:"model"`
+	Stream          bool   `json:"stream"`
+	Messages        int    `json:"messages"`
+	SystemBytes     int    `json:"system_bytes"`
+	SystemSHA       string `json:"system_sha,omitempty"`
+	Tools           int    `json:"tools"`
+	ToolNames       string `json:"tool_names,omitempty"`
+	InputTokens     int64  `json:"input_tokens"`
+	OutputTokens    int64  `json:"output_tokens"`
+	CacheReadTokens int64  `json:"cache_read_tokens,omitempty"`
+	Finish          string `json:"finish,omitempty"`
+	Error           string `json:"error,omitempty"`
+}
+
+var (
+	ledgerMu    sync.Mutex
+	ledgerFiles = map[string]*os.File{}
+)
+
+// ledgerPath là tệp sổ ghi đang bật, đọc từ env tin cậy (chụp đầu main) nên
+// `.env` của repo không chuyển được sổ ra chỗ khác.
+func ledgerPath() string { return execpolicy.TrustedEnv(execpolicy.LLMLedgerEnv) }
+
+// writeLedger nối một dòng vào tệp path (mở một lần mỗi tiến trình, 0600).
+func writeLedger(path string, e ledgerEntry) {
+	line, err := json.Marshal(e)
+	if err != nil {
+		return
+	}
+	ledgerMu.Lock()
+	defer ledgerMu.Unlock()
+	f, ok := ledgerFiles[path]
+	if !ok {
+		f, err = os.OpenFile(path, os.O_WRONLY|os.O_APPEND|os.O_CREATE, 0o600)
+		if err != nil {
+			slog.Warn("Cannot open the LLM ledger", "path", path, "error", err)
+		}
+		ledgerFiles[path] = f // nil khi lỗi: chỉ cảnh báo một lần
+	}
+	if f != nil {
+		_, _ = f.Write(append(line, '\n'))
+	}
+}
+
+// ledgerModel bọc model để ghi sổ mỗi lời gọi. provider/model là nhãn cấu hình
+// của chính model được gọi (sau mọi lần chọn/khoá), không phải model "đang chọn".
+type ledgerModel struct {
+	fantasy.LanguageModel
+	provider, model, path string
+}
+
+// newLedgerModel trả m nguyên vẹn khi sổ ghi tắt (path rỗng).
+func newLedgerModel(m fantasy.LanguageModel, provider, model, path string) fantasy.LanguageModel {
+	if m == nil || path == "" {
+		return m
+	}
+	return ledgerModel{LanguageModel: m, provider: provider, model: model, path: path}
+}
+
+func (m ledgerModel) entry(ctx context.Context, call fantasy.Call, stream bool, start time.Time) ledgerEntry {
+	var system strings.Builder
+	for _, msg := range call.Prompt {
+		if msg.Role != fantasy.MessageRoleSystem {
+			continue
+		}
+		for _, part := range msg.Content {
+			if tp, ok := fantasy.AsMessagePart[fantasy.TextPart](part); ok {
+				system.WriteString(tp.Text)
+			}
+		}
+	}
+	e := ledgerEntry{
+		Time: start.UTC().Format(time.RFC3339Nano), Role: llmRole(ctx), Provider: m.provider, Model: m.model,
+		Stream: stream, Messages: len(call.Prompt), SystemBytes: system.Len(), Tools: len(call.Tools),
+	}
+	if sid, ok := ctx.Value(tools.SessionIDContextKey).(string); ok {
+		e.SessionID = sid
+	}
+	names := make([]string, 0, len(call.Tools))
+	for _, t := range call.Tools {
+		names = append(names, t.GetName())
+	}
+	sort.Strings(names)
+	e.ToolNames = strings.Join(names, ",")
+	if system.Len() > 0 {
+		sum := sha256.Sum256([]byte(system.String()))
+		e.SystemSHA = hex.EncodeToString(sum[:6])
+	}
+	return e
+}
+
+func (m ledgerModel) Generate(ctx context.Context, call fantasy.Call) (*fantasy.Response, error) {
+	start := time.Now()
+	e := m.entry(ctx, call, false, start)
+	resp, err := m.LanguageModel.Generate(ctx, call)
+	e.DurationMS = time.Since(start).Milliseconds()
+	if err != nil {
+		e.Error = ledgerErrorKind(err)
+	} else if resp != nil {
+		e.InputTokens, e.OutputTokens, e.CacheReadTokens = resp.Usage.InputTokens, resp.Usage.OutputTokens, resp.Usage.CacheReadTokens
+		e.Finish = string(resp.FinishReason)
+	}
+	writeLedger(m.path, e)
+	return resp, err
+}
+
+func (m ledgerModel) Stream(ctx context.Context, call fantasy.Call) (fantasy.StreamResponse, error) {
+	start := time.Now()
+	e := m.entry(ctx, call, true, start)
+	inner, err := m.LanguageModel.Stream(ctx, call)
+	if err != nil {
+		e.DurationMS = time.Since(start).Milliseconds()
+		e.Error = ledgerErrorKind(err)
+		writeLedger(m.path, e)
+		return nil, err
+	}
+	return func(yield func(fantasy.StreamPart) bool) {
+		defer func() {
+			e.DurationMS = time.Since(start).Milliseconds()
+			writeLedger(m.path, e)
+		}()
+		inner(func(part fantasy.StreamPart) bool {
+			if part.Type == fantasy.StreamPartTypeFinish {
+				e.InputTokens, e.OutputTokens, e.CacheReadTokens = part.Usage.InputTokens, part.Usage.OutputTokens, part.Usage.CacheReadTokens
+				e.Finish = string(part.FinishReason)
+			}
+			if part.Error != nil && e.Error == "" {
+				e.Error = ledgerErrorKind(part.Error)
+			}
+			return yield(part)
+		})
+	}, nil
+}
+
+// ledgerErrorKind chỉ ghi loại lỗi (và mã HTTP): server local hay chép mẩu prompt
+// vào thông báo lỗi, nên văn bản lỗi không vào sổ.
+func ledgerErrorKind(err error) string {
+	var pe *fantasy.ProviderError
+	switch {
+	case errors.As(err, &pe):
+		return fmt.Sprintf("provider_error status=%d", pe.StatusCode)
+	case errors.Is(err, context.Canceled):
+		return "canceled"
+	case errors.Is(err, context.DeadlineExceeded):
+		return "timeout"
+	}
+	return fmt.Sprintf("%T", err)
+}
diff --git a/internal/agent/llm_ledger_test.go b/internal/agent/llm_ledger_test.go
new file mode 100644
index 00000000..d9634e93
--- /dev/null
+++ b/internal/agent/llm_ledger_test.go
@@ -0,0 +1,111 @@
+package agent
+
+import (
+	"bufio"
+	"context"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"charm.land/catwalk/pkg/catwalk"
+	"charm.land/fantasy"
+	"github.com/charmbracelet/crush/internal/agent/notify"
+	"github.com/charmbracelet/crush/internal/pubsub"
+	"github.com/stretchr/testify/require"
+)
+
+func readLedger(t *testing.T, path string) []ledgerEntry {
+	t.Helper()
+	f, err := os.Open(path)
+	require.NoError(t, err)
+	defer f.Close()
+	var out []ledgerEntry
+	sc := bufio.NewScanner(f)
+	for sc.Scan() {
+		var e ledgerEntry
+		require.NoError(t, json.Unmarshal(sc.Bytes(), &e))
+		out = append(out, e)
+	}
+	return out
+}
+
+// Sổ ghi nói đúng model nào đã nhận lời gọi nào, với vai trò của lời gọi, và
+// usage của CHÍNH lời gọi đó; không chứa nội dung prompt.
+func TestLedgerRecordsEachCallWithRoleProviderAndUsage(t *testing.T) {
+	env := testEnv(t)
+	broker := pubsub.NewBroker[notify.RunComplete]()
+	t.Cleanup(broker.Shutdown)
+	path := filepath.Join(t.TempDir(), "ledger.jsonl")
+	cw := catwalk.Model{ContextWindow: 1000, DefaultMaxTokens: 100}
+	large := modelWith(newLedgerModel(&scriptModel{script: []string{"tool_small", "done"}, summaryText: "S"}, "qwen", "qwen3-coder", path), "qwen", "qwen3-coder", cw)
+	small := modelWith(newLedgerModel(&finishStreamModel{text: "title"}, "glm", "glm-5.3-flash", path), "glm", "glm-5.3-flash", cw)
+	sa := NewSessionAgent(SessionAgentOptions{
+		LargeModel: large, SmallModel: small, IsYolo: true,
+		Sessions: env.sessions, Messages: env.messages, RunComplete: broker,
+		Tools: []fantasy.AgentTool{namedTool("noop")},
+	}).(*sessionAgent)
+	sess, err := env.sessions.Create(t.Context(), "session")
+	require.NoError(t, err)
+	ch := broker.Subscribe(t.Context())
+
+	_, err = sa.Run(t.Context(), SessionAgentCall{SessionID: sess.ID, RunID: "x", Prompt: "SECRET-PROMPT-TEXT fix it"})
+	require.NoError(t, err)
+	waitRunComplete(t, ch, "x")
+	sa.GenerateTitle(t.Context(), sess.ID, "SECRET-PROMPT-TEXT fix it")
+
+	entries := readLedger(t, path)
+	byRole := map[string][]ledgerEntry{}
+	for _, e := range entries {
+		byRole[e.Role] = append(byRole[e.Role], e)
+		require.NotEmpty(t, e.Time)
+	}
+	require.Len(t, byRole["main"], 2, "two main steps: tool, then done")
+	for _, e := range byRole["main"] {
+		require.Equal(t, "qwen", e.Provider)
+		require.Equal(t, "qwen3-coder", e.Model)
+		require.Equal(t, sess.ID, e.SessionID)
+		require.True(t, e.Stream)
+		require.Equal(t, "noop", e.ToolNames, "the tool palette offered to the model")
+	}
+	require.EqualValues(t, 10, byRole["main"][0].InputTokens, "usage of that call, not the session total")
+	require.NotEmpty(t, byRole["title"])
+	require.Equal(t, "glm", byRole["title"][0].Provider, "the ledger shows the cross-provider title call")
+
+	raw, err := os.ReadFile(path)
+	require.NoError(t, err)
+	require.NotContains(t, string(raw), "SECRET-PROMPT-TEXT", "sizes and hashes only, never prompt text")
+	info, err := os.Stat(path)
+	require.NoError(t, err)
+	require.Equal(t, os.FileMode(0o600), info.Mode().Perm())
+}
+
+type failingStreamModel struct{ finishStreamModel }
+
+func (*failingStreamModel) Stream(context.Context, fantasy.Call) (fantasy.StreamResponse, error) {
+	return nil, &fantasy.ProviderError{StatusCode: 400, Message: "Error rendering prompt: SECRET-PROMPT-TEXT"}
+}
+
+// Server OpenAI-compat local (llama.cpp, LM Studio) hay chép mẩu prompt vào thông
+// báo lỗi: sổ ghi chỉ giữ loại lỗi và mã HTTP, không giữ văn bản lỗi.
+func TestLedgerRecordsTheErrorKindNotItsText(t *testing.T) {
+	t.Parallel()
+	path := filepath.Join(t.TempDir(), "ledger.jsonl")
+	m := newLedgerModel(&failingStreamModel{}, "local", "qwen", path)
+	_, err := m.Stream(t.Context(), fantasy.Call{})
+	require.Error(t, err)
+
+	entries := readLedger(t, path)
+	require.Len(t, entries, 1)
+	require.Equal(t, "provider_error status=400", entries[0].Error)
+	raw, err := os.ReadFile(path)
+	require.NoError(t, err)
+	require.NotContains(t, string(raw), "SECRET-PROMPT-TEXT")
+}
+
+// Tắt (path rỗng) thì không bọc gì: không chi phí, không tệp.
+func TestLedgerOffReturnsTheModelUnchanged(t *testing.T) {
+	t.Parallel()
+	m := &finishStreamModel{text: "x"}
+	require.Same(t, fantasy.LanguageModel(m), newLedgerModel(m, "p", "m", ""))
+}
diff --git a/internal/agent/provider_isolation_test.go b/internal/agent/provider_isolation_test.go
new file mode 100644
index 00000000..1569810f
--- /dev/null
+++ b/internal/agent/provider_isolation_test.go
@@ -0,0 +1,48 @@
+package agent
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/charmbracelet/crush/internal/config"
+	"github.com/stretchr/testify/require"
+)
+
+// Phiên chạy trên provider X: việc phụ (tiêu đề, agentic_fetch) không được gửi
+// prompt sang provider Y chỉ vì model small cấu hình ở Y (probe P-01).
+func TestSameProviderSmall(t *testing.T) {
+	t.Parallel()
+	qwen := config.SelectedModel{Provider: "qwen", Model: "qwen3-coder"}
+	glmFlash := config.SelectedModel{Provider: "glm", Model: "glm-5.3-flash"}
+	glm := config.SelectedModel{Provider: "glm", Model: "glm-5.3"}
+	require.Equal(t, qwen, sameProviderSmall(qwen, glmFlash), "cross-provider small falls back to the main model")
+	require.Equal(t, glmFlash, sameProviderSmall(glm, glmFlash), "same-provider small is kept")
+}
+
+// Cả đường dựng model thật của coordinator: large ở qwen, small ở glm thì model
+// small trả ra là của qwen.
+func TestBuildAgentModelsKeepsSmallOnTheMainProvider(t *testing.T) {
+	env := testEnv(t)
+	crushJSON := `{
+  "options": {"disable_default_providers": true, "disable_provider_auto_update": true},
+  "providers": {
+    "qwen": {"id": "qwen", "name": "Qwen", "type": "openai-compat", "base_url": "http://127.0.0.1:9/qwen/v1", "api_key": "x",
+      "models": [{"id": "qwen3-coder", "name": "q", "context_window": 8192, "default_max_tokens": 128}]},
+    "glm": {"id": "glm", "name": "GLM", "type": "openai-compat", "base_url": "http://127.0.0.1:9/glm/v1", "api_key": "y",
+      "models": [{"id": "glm-5.3-flash", "name": "g", "context_window": 8192, "default_max_tokens": 128}]}},
+  "models": {"large": {"provider": "qwen", "model": "qwen3-coder"},
+             "small": {"provider": "glm", "model": "glm-5.3-flash"}}
+}`
+	require.NoError(t, os.WriteFile(filepath.Join(env.workingDir, "crush.json"), []byte(crushJSON), 0o644))
+	cfg, err := config.Init(env.workingDir, "", false)
+	require.NoError(t, err)
+	cfg.SetupAgents()
+	coord := &coordinator{cfg: cfg, sessions: env.sessions, messages: env.messages, permissions: env.permissions, history: env.history, filetracker: *env.filetracker}
+
+	large, small, err := coord.buildAgentModels(t.Context(), false)
+	require.NoError(t, err)
+	require.Equal(t, "qwen", large.ModelCfg.Provider)
+	require.Equal(t, "qwen", small.ModelCfg.Provider)
+	require.Equal(t, "qwen3-coder", small.ModelCfg.Model)
+}
