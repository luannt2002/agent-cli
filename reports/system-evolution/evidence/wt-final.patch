+// mang lý do thật, không thành ABANDONED "chết trước khi ghi báo cáo" (soát LC-1).
+func TestExecuteRoutine_WorktreeFailureWritesAnErrorReport(t *testing.T) {
+	t.Cleanup(func() { execpolicy.SetUnattended(false, false) })
+	e := newRoutineEnv(t)
