+type contextOverflowError struct {
+	used, window, threshold int64
+}
+
+func (e *contextOverflowError) Error() string {
+	return fmt.Sprintf("context window too small: right after auto-summarizing, the next request already uses %d of %d tokens (auto-summarize keeps %d free); raise the model's context_window or shrink the fixed prompt (tools, MCP servers, context files)", e.used, e.window, e.threshold)
