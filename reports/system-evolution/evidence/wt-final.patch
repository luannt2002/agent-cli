 			}
-			if d.IsDir() || d.Name() != SkillFileName {
+			// Thư mục ẩn bên dưới gốc (`.trash` của trình quản lý skill, `.git`) chứa
+			// bản đã xoá hoặc không dành cho agent; gốc thì có thể nằm trong thư mục
