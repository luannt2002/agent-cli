+// promptRecorder ghi messages của mỗi lần Stream rồi trả "done".
+type promptRecorder struct {
+	finishStreamModel
+	mu      sync.Mutex
+	prompts []fantasy.Prompt
+}
+
+func (m *promptRecorder) Stream(ctx context.Context, call fantasy.Call) (fantasy.StreamResponse, error) {
+	m.mu.Lock()
+	m.prompts = append(m.prompts, call.Prompt)
+	m.mu.Unlock()
+	return m.finishStreamModel.Stream(ctx, call)
+}
+
+// Todo reminder bảo model dùng tool `todos`: chỉ lượt có tool đó mới nhận
+// (agentic_fetch, plan không có `todos`).
+func TestTodoReminderOnlyWithTodosTool(t *testing.T) {
+	t.Parallel()
+	for _, tc := range []struct {
+		name  string
+		tools []fantasy.AgentTool
+		want  bool
+	}{
+		{"without todos", []fantasy.AgentTool{namedTool("view")}, false},
+		{"with todos", []fantasy.AgentTool{namedTool("view"), namedTool(tools.TodosToolName)}, true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+			env := testEnv(t)
+			rec := &promptRecorder{finishStreamModel: finishStreamModel{text: "done"}}
+			cw := catwalk.Model{ContextWindow: 100000, DefaultMaxTokens: 100}
+			sa := NewSessionAgent(SessionAgentOptions{
+				LargeModel: modelWith(rec, "prov", "model", cw),
+				SmallModel: modelWith(&finishStreamModel{text: "title"}, "prov", "small", cw),
+				IsYolo:     true,
+				Sessions:   env.sessions,
+				Messages:   env.messages,
+				Tools:      tc.tools,
+			})
+			sess, err := env.sessions.Create(t.Context(), "session")
+			require.NoError(t, err)
+			_, err = sa.Run(t.Context(), SessionAgentCall{SessionID: sess.ID, Prompt: "hello"})
+			require.NoError(t, err)
+
+			rec.mu.Lock()
+			defer rec.mu.Unlock()
+			require.NotEmpty(t, rec.prompts, "the model was never called")
+			var got bool
+			for _, msg := range rec.prompts[0] {
+				for _, part := range msg.Content {
+					if tp, ok := fantasy.AsMessagePart[fantasy.TextPart](part); ok && strings.Contains(tp.Text, "your todo list is currently empty") {
+						got = true
+					}
+				}
+			}
+			require.Equal(t, tc.want, got, "todo reminder sent")
+		})
+	}
+}
