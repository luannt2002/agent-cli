+func TestStrayDataDirs(t *testing.T) {
+	if _, err := exec.LookPath("git"); err != nil {
+		t.Skip("git not available")
+	}
+	repo, err := filepath.EvalSymlinks(t.TempDir())
+	require.NoError(t, err)
+	sub := filepath.Join(repo, "a", "b")
+	stray := filepath.Join(sub, defaultDataDirectory)
+	rootData := filepath.Join(repo, defaultDataDirectory)
+	require.NoError(t, os.MkdirAll(stray, 0o755))
+	require.NoError(t, os.Mkdir(rootData, 0o755))
+	gitInit := exec.CommandContext(t.Context(), "git", "init", "-q")
+	gitInit.Dir = repo
+	require.NoError(t, gitInit.Run())
+	link := filepath.Join(t.TempDir(), "link")
+	require.NoError(t, os.Symlink(sub, link))
+
+	cfg := &Config{}
+	cfg.setDefaults(link, "")
+	require.Equal(t, rootData, cfg.Options.DataDirectory, "through a symlink into the project too")
+
+	require.Equal(t, []string{stray}, StrayDataDirs(sub, rootData))
+	require.Equal(t, []string{stray}, StrayDataDirs(link, rootData))
+	require.Empty(t, StrayDataDirs(repo, rootData), "nothing to report from the root")
+	require.Empty(t, StrayDataDirs(sub, stray), "-D on the old one: it is in use")
+}
