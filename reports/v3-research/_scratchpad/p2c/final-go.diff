+// StrayDataDirs liệt kê các .crush nằm giữa workingDir và gốc dự án (không
+// tính gốc), trừ dataDir: bản cũ dùng .crush gần nhất khi mở từ thư mục con.
+// Nay chúng không được mở, cũng không bao giờ tự gộp.
+func StrayDataDirs(workingDir, dataDir string) []string {
+	root := projectBoundary(workingDir)
+	found, err := fsext.LookupBounded(workingDir, root, defaultDataDirectory)
+	if err != nil {
