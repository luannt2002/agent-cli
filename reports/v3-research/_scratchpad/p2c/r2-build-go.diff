+// dataDir. Không tự gộp, không xoá.
+func warnLegacyDataDirs(cmd *cobra.Command, cwd, dataDir string) {
+	root := config.ProjectRoot(cwd)
+	for _, d := range config.LegacyDataDirs(cwd, root, dataDir, knownDataDirs(root)) {
+		warnUser(cmd, fmt.Sprintf("warning: %s is not used: agent-cli now keeps one data directory per project, %s. Nothing was merged or deleted. To open the sessions stored there: CRUSH_CLIENT_SERVER=0 agent-cli -c %s -D %s (merging them into the project is up to you).",
