+// resetLedgerTurn quên lỗi ghi sổ của lượt trước khi session bắt đầu lượt mới.
+func resetLedgerTurn(sessionID string) {
+	ledgerMu.Lock()
+	defer ledgerMu.Unlock()
+	delete(ledgerWriteErrs, sessionID)
